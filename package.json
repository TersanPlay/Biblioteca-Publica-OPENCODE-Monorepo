{
  "name": "biblioteca-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @library/shared build && pnpm -r --parallel --filter @library/api --filter @library/web dev",
    "dev:web": "pnpm --filter @library/web dev",
    "dev:api": "pnpm --filter @library/shared build && pnpm --filter @library/api dev",
    "build": "pnpm --filter @library/shared build && pnpm --filter @library/api build && pnpm --filter @library/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "postinstall": "pnpm --filter @library/shared build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.22.0"
  }
}
